# Step 1: Critical Termux Dynamic Patch (ChromaDB import hone se pehle zaroori hai)
try:
    __import__('pysqlite3')
    sys.modules['sqlite3'] = sys.modules.pop('pysqlite3')
except ImportError:
    pass

import chromadb
import psycopg2
from psycopg2 import pool

class LocalMemoryEngine:
    def __init__(self, db_path: str = "./data/parthis_memory"):
        """
        Termux-compatible Vector Store Engine using ChromaDB + Cloud Sync Connector
        """
        self.db_path = db_path
        
        # Ensure local data directory exists
        os.makedirs(self.db_path, exist_ok=True)
        
        # 1. Initialize Persistent ChromaDB Client
        self.client = chromadb.PersistentClient(path=self.db_path)
        self.collection = self.client.get_or_create_collection(
            name="parthis_knowledge_base"
        )
        print(f"[LocalMemoryEngine] SQLite patch verified. Memory online at: {self.db_path}")

        # 2. Initialize Supabase Cloud Connection Pool (Port 6543)
        self.db_url = os.getenv("SUPABASE_DB_URL")
        self.cloud_pool = None
        if self.db_url:
            self._initialize_cloud_pool()
        else:
            print("[CloudSync] Warning: SUPABASE_DB_URL not found. Running in local-only mode.")

    def _initialize_cloud_pool(self):
        """Initializes psycopg2 Threaded Connection Pool for Cloud Sync"""
        try:
            self.cloud_pool = psycopg2.pool.ThreadedConnectionPool(
                minconn=1,
                maxconn=5,
                dsn=self.db_url
            )
            print("[CloudSync] Connected to Supabase Pooler (Port 6543).")
        except Exception as e:
            print(f"[CloudSync] Connection Pool Failed: {e}")
            self.cloud_pool = None

    def add_memory(self, doc_id: str, text_content: str, metadata: dict = None):
        """
        Vector Database (Local) me knowledge save karta hai
        """
        try:
            self.collection.upsert(
                ids=[doc_id],
                documents=[text_content],
                metadatas=[metadata] if metadata else None
            )
            return True
        except Exception as e:
            print(f"[LocalMemoryEngine] Error adding memory: {e}")
            return False

    def recall_context(self, query: str, top_k: int = 3) -> list:
        """
        Query ke basis par relevant vector memories retrieve karta hai
        """
        try:
            results = self.collection.query(
                query_texts=[query],
                n_results=top_k
            )
            documents = results.get("documents", [[]])[0]
            return documents
        except Exception as e:
            print(f"[LocalMemoryEngine] Error recalling memory: {e}")
            return []

    def execute_cloud_query(self, query: str, params: tuple = None, fetch_results: bool = True):
        """
        Supabase Cloud database par safely query execute karne ke liye helper
        """
        if not self.cloud_pool:
            print("[CloudSync] Database connection pool unavailable.")
            return None

        conn = None
        try:
            conn = self.cloud_pool.getconn()
            with conn.cursor() as cursor:
                cursor.execute(query, params)
                if fetch_results:
                    results = cursor.fetchall()
                else:
                    conn.commit()
                    results = True
            return results
        except Exception as e:
            print(f"[CloudSync] Query Error: {e}")
            if conn:
                conn.rollback()
            return None
        finally:
            if conn and self.cloud_pool:
                self.cloud_pool.putconn(conn)

if __name__ == "__main__":
    memory = LocalMemoryEngine()
    memory.add_memory(doc_id="test_1", text_content="Parthis is a resilient autonomous AI assistant.")
    print("Test Local Recall:", memory.recall_context("Who is Parthis?"))
